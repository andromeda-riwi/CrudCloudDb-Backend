# Variables de entorno de referencia (NO usar en producción)

# Entorno de ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# JWT
JWT_SECRET_TOKEN=CambiaEsteTokenSuperSecreto

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret

# SendGrid
SENDGRID_API_KEY=tu_api_key
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=ApexDb Team

# Dashboard
APP_DASHBOARD_URL=https://andromeda.andrescortes.dev/dashboard

# Cadenas de conexión (ejemplos)
DEFAULT_CONNECTION=Host=localhost;Port=5432;Database=ccd_dev_db;Username=usuario;Password=contraseña
ADMIN_POSTGRES_CONNECTION=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=contraseña
ADMIN_MYSQL_CONNECTION=Server=localhost;Port=3306;Database=mysql;User Id=root;Password=contraseña
ADMIN_SQLSERVER_CONNECTION=Server=localhost,1433;Database=master;User Id=sa;Password=contraseña;TrustServerCertificate=True
